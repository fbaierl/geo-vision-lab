# LangSmith Configuration
# Get your API key at: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-api-key-here
LANGSMITH_PROJECT=geo-vision-lab

# Nominatim Geocoding Service
# Optional: Use self-hosted Nominatim to avoid rate limiting
# Default: Uses public Nominatim (nominatim.openstreetmap.org)
# For self-hosted: http://nominatim:8080/search
NOMINATIM_URL=
NOMINATIM_TIMEOUT=10

# Online LLM (Groq)
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
USE_ONLINE_LLM=false
ONLINE_LLM_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct
