# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=geo-vision-lab

# Nominatim Geocoding Service
# For self-hosted Nominatim (recommended - avoids rate limiting)
NOMINATIM_URL=http://nominatim:8080/search
NOMINATIM_TIMEOUT=10

# Online LLM (Groq)
GROQ_API_KEY=your-groq-api-key
USE_ONLINE_LLM=false
ONLINE_LLM_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct

# RAG Features Configuration
RAG_GRADER_ENABLED=false
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TOP_K=3
RAG_RERANKER_CANDIDATES_K=20
