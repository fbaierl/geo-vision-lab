graph TD
    subgraph Infrastructure ["Core Infrastructure (Docker)"]
        MDB[("MongoDB 8.2+<br/>(Vector Search)")]
        OL["Ollama<br/>(Qwen 3.5 9B/4B + Qwen 2.5 0.5B)"]
        LK["Loki + Promtail<br/>(Logs)"]
        GF["Grafana<br/>(Monitoring)"]
        ME["Mongo Express<br/>(DB Admin)"]
    end

    subgraph Pipeline ["Ingestion Pipeline"]
        PDF["PDF/MD Reports<br/>(./documents/)"] --> ING["ingest.py<br/>(RecursiveCharacterSplitter)"]
        ING -->|"Vector Embeddings<br/>(all-MiniLM-L6-v2)"| MDB
    end

    subgraph Agent ["GeoVision Intelligence Agent (LangGraph)"]
        UI["Tactical Terminal<br/>(Vanilla JS + Leaflet)"] <--> APP["FastAPI Backend<br/>(main.py)"]
        APP <--> LG["LangGraph Controller<br/>(graph.py)"]

        subgraph Workflow ["Agent Workflow"]
            VS["vector_search_node<br/>(Mandatory First Step)"]
            AG["agent_node<br/>(Worker LLM + Tools)"]
            RV["reviewer_node<br/>(QA Critic LLM)"]
            ONT["ontology_extractor_node<br/>(Sub-Graph)"]
        end

        LG --> VS
        VS --> AG
        AG -->|"Tool Calls"| TN["tool_node<br/>(DuckDuckGo, Wikipedia)"]
        TN --> AG
        AG -->|"Final Draft"| RV
        RV -->|"VALID"| ONT
        RV -->|"INVALID (retry)| AG

        ONT -->|"Entity/Link Extraction"| OL
        ONT -->|"Geocoding"| NOM["Nominatim API"]
        ONT -->|"Graph Storage"| MDB
    end

    subgraph Tools ["External Services"]
        DDG["DuckDuckGo<br/>(Live Web)"]
        WIKI["Wikipedia API"]
        NOM
    end

    TN --> DDG
    TN --> WIKI

    %% Observability
    APP -.->|"Stream Logs"| LK
    ING -.->|"Stream Logs"| LK
    LK --> GF
